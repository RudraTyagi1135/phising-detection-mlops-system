# Application
APP_ENV=development
CONFIG_PATH=config.yaml
LOG_LEVEL=INFO

# Data source: local for reproducible development/CI, mongodb for Atlas-backed training
DATA_INGESTION_SOURCE=local
LOCAL_DATA_FILE_PATH=network_data/phisingData.csv

# MongoDB Atlas
# Legacy MONGO_DB_URL is still supported, but MONGODB_URI is preferred.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DATABASE=RUDRA1
MONGODB_COLLECTION=Network_data
MONGODB_PREDICTION_LOG_COLLECTION=prediction_logs
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=50

# DagsHub + DVC + MLflow
DAGSHUB_REPO_OWNER=<dagshub-username-or-org>
DAGSHUB_REPO_NAME=phising-detection-mlops-system
DAGSHUB_TOKEN=<dagshub-token>
DVC_REMOTE_URL=https://dagshub.com/<dagshub-username-or-org>/phising-detection-mlops-system.dvc
MLFLOW_TRACKING_URI=https://dagshub.com/<dagshub-username-or-org>/phising-detection-mlops-system.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username-or-org>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>
MLFLOW_EXPERIMENT_NAME=phishing-detection
MLFLOW_REGISTERED_MODEL_NAME=phishing-detection-model

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
TRAINING_ENDPOINT_ENABLED=true

# AWS deployment
AWS_REGION=us-east-1
AWS_ROLE_TO_ASSUME=arn:aws:iam::<account-id>:role/<github-actions-deploy-role>
ECR_REPOSITORY_NAME=phishing-detection-api
ECS_CLUSTER=phishing-detection-cluster
ECS_SERVICE=phishing-detection-service
ECS_TASK_DEFINITION_FAMILY=phishing-detection-api
ECS_CONTAINER_NAME=phishing-detection-api
ECS_EXECUTION_ROLE_ARN=arn:aws:iam::<account-id>:role/ecsTaskExecutionRole
ECS_TASK_ROLE_ARN=arn:aws:iam::<account-id>:role/phishing-detection-task-role
MONGODB_URI_SECRET_ARN=arn:aws:secretsmanager:us-east-1:<account-id>:secret:phishing/MONGODB_URI
DAGSHUB_TOKEN_SECRET_ARN=arn:aws:secretsmanager:us-east-1:<account-id>:secret:phishing/DAGSHUB_TOKEN
